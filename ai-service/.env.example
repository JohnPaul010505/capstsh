# --- HTTP ---
# Must match AI_SERVICE_URL in admin/server/index.js (default http://localhost:8001).
# Port 3001 is already taken by the Express admin server.
PORT=8001
# Comma-separated origins, or * for any origin
CORS_ORIGINS=*

# --- Supabase (service role - server side only, never expose to clients) ---
# BOTH values are required: services/db.py raises at import without them.
SUPABASE_URL=https://itxetmemsztydtngaqjx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
