# --- Gemini (required: /api/ai/identify-food returns 500 without it) ---
GEMINI_API_KEY=
# Any model name valid for google-generativeai 0.8.x
GEMINI_MODEL=gemini-2.0-flash

# --- HTTP ---
# Default 3001 matches the admin Vite proxy ('/api' -> localhost:3001) and the mobile API_BASE_URL.
PORT=3001
# Comma-separated origins, or * for any origin
CORS_ORIGINS=*

